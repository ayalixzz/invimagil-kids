datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  companies     Company[]
  achievements  GameProgress?
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Company {
  id        String    @id @default(cuid())
  name      String
  slogan    String?
  members   String?   // Nombres de los integrantes
  logoIcon  String?   // Icono de la empresa (cookie, juice, ice-cream, etc.)
  logoColor String?   // Color del logotipo
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  userId    String?
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  products  Product[]
}

model Product {
  id                 String   @id @default(cuid())
  name               String
  type               String   // solid, liquid, semisolid
  eatOrDrink         String   // comer, tomar
  packaging          String   // bolsa, caja, botella, frasco
  flavor             String?
  ingredients        Json     // Lista de ingredientes: [{name: "Harina", percentage: 40}]
  recipeSteps        Json     // Lista de pasos de preparación
  preparationTime    String?  // Tiempo estimado
  bpmPassed          Boolean  @default(false)
  bpmScore           Int      @default(0)
  medals             Json?    // Medallas obtenidas: ["higiene", "seguridad", "calidad"]
  registrationNo     String?  // Registro sanitario ficticio, ej: RSM-2025-NIÑOS-0001
  approved           Boolean  @default(false)
  score              Int      @default(0)
  levelReached       String?  // Nivel al finalizar la ceremonia
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  companyId          String
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model GameProgress {
  id        String   @id @default(cuid())
  points    Int      @default(0)
  level     String   @default("Emprendedor Novato")
  medals    Json     // Medallas ganadas, ej: ["higiene", "seguridad"]
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  updatedAt DateTime @updatedAt
}
